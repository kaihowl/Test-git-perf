{
  "name": "demo-utils",
  "version": "1.0.0",
  "description": "A demo utility library with build tools and comprehensive tests",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:perf": "jest --testPathPattern=tests/performance",
    "test:all": "npm run test:unit && npm run test:perf",
    "clean": "rm -rf dist",
    "prepublish": "npm run clean && npm run build"
  },
  "keywords": ["demo", "utils", "testing"],
  "author": "Terragon Labs",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  }
}
